# ===== SolBot CMD • Uji 3 Mode (DEMO) =====
# Saldo demo per mode (SOL). Tidak ada transaksi asli.
START_SOL=1
# Mode yang dijalankan: easy, medium, hard
MODES=easy,medium,hard,exclusive,narasi

# Notifikasi Netlify (sudah diisi, jangan dibagikan)
NETLIFY_URL=https://solbot-notif-isla.netlify.app
NETLIFY_KEY=3kZ0xT2BhrMstdwJAFGQt8JHQhtBtM2S
# Kunci untuk membuka halaman: https://solbot-notif-isla.netlify.app/#k=A-bSo1BUpHIeiTeA1FQIxA
VIEW_KEY=A-bSo1BUpHIeiTeA1FQIxA

# Jam beli. false = 24 jam (cocok untuk tes). true = hanya TRADE_START-TRADE_END WIB
TRADE_HOURS_ENABLED=false
TRADE_START=20:00
TRADE_END=03:00

# Opsional
RPC_URL=
HELIUS_API_KEY=
# GMGN sering diblokir Cloudflare. Ubah ke false kalau terus gagal.
TRIG_GMGN=true
TRIG_METEORA=true
# Telegram opsional (kosongkan kalau hanya pakai Netlify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Biaya simulasi demo (agar mirip real)
DEMO_FEE_SOL=0.0005
DEMO_SLIPPAGE_PCT=1

# Saldo habis/kurang untuk beli (dan tidak ada posisi) -> mode berhenti total sampai direset
# Reset: python solbot.py --reset   atau   python solbot.py --reset hard
AUTO_STOP_LOW_BALANCE=true
